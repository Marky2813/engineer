// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String   @id @default(uuid())
  username        String   @unique
  password        String   
  gender          Gender
  channelName     String   @unique
  banner          String?
  profilePicture  String?
  subscriberCount Int      @default(0)
  description     String?
  uploads         Uploads[]
  comments        Comment[]
  subscribedTo    Subscription[] @relation("relation2")
  subscribedBy    Subscription[] @relation("relation1")
  likes           Like[]
  watchHistory    WatchHistory[]
}

model Uploads {
  id              String    @id  @default(uuid())
  videoUrl        String
  userId          String
  thumbnail       String
  description     String?
  user            User      @relation(fields:[userId], references: [id])
  createdAt       DateTime  @default(now())
  comment         Comment[]
  likes           Like[]
  watchHistory    WatchHistory[]
}

model Subscription {
  id              String    @id  @default(uuid())
  subscribedToId    String 
  subscribedById    String
  subscribedBy    User     @relation("relation1", fields:[subscribedById], references: [id])
  subscribedTo    User     @relation("relation2", fields:[subscribedToId], references: [id])
  @@unique([subscribedById, subscribedToId])
}
// relation fields are used by prisma to specify the relationships between models. we can use these to query the linked data. 

model Comment {
  id             String    @id  @default(uuid())
  comment        String 
  userId         String 
  uploadId       String
  createdAt      DateTime @default(now())
  user           User     @relation(fields:[userId], references: [id])
  uploads        Uploads  @relation(fields:[uploadId], references: [id]) 
}

model Like {
  id             String    @id  @default(uuid())
  userId         String 
  uploadId       String
  user           User     @relation(fields: [userId], references: [id])
  uploads        Uploads  @relation(fields: [uploadId], references: [id])
  @@unique([userId, uploadId])
}

model WatchHistory {
  id             String @id @default(uuid())
  userId         String 
  uploadId       String
  user           User     @relation(fields: [userId], references: [id])
  uploads        Uploads  @relation(fields: [uploadId], references: [id])
}


enum Gender {
  Male 
  Female 
  Other
}